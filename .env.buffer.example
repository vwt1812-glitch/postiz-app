# Copy to .env.buffer. Never use production databases or production volumes here.
JWT_SECRET=replace-with-a-new-random-test-secret
BUFFER_TEST_IMAGE=ghcr.io/vwt1812-glitch/postiz-app:buffer-REPLACE_WITH_VERIFIED_COMMIT
BUFFER_POSTIZ_ORGANIZATION_ID=
BUFFER_ORGANIZATION_ID=
# Exact Buffer channel IDs, two X and one TikTok; never account handles.
BUFFER_CHANNEL_IDS=
# Comma-separated HTTPS origins serving permanent, unauthenticated media files.
BUFFER_MEDIA_ORIGINS=
BUFFER_TEST_DISABLE_REGISTRATION=true
# Secret value is read from .secrets/buffer-api-key, mounted only at runtime.
